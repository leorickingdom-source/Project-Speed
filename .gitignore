# Unity generated / regenerated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# IDE / OS
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.DS_Store
Thumbs.db

# Builds / packages
*.apk
*.aab
*.unitypackage
*.app
ExportedObj/
crashlytics-build.properties
sysinfo.txt
*.stackdump

# My debug screenshots (regenerated on demand)
/[Aa]ssets/[Ss]creenshots/
/[Aa]ssets/[Ss]creenshots.meta

# Unity crash-recovery dumps
Assets/_Recovery/
Assets/_Recovery.meta

# Plastic SCM workspace state — rewritten constantly, ~600KB binary churn per commit
.plastic/
